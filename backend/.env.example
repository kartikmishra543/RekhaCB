APP_NAME=RekhaCB
ENVIRONMENT=dev
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite+aiosqlite:///./storage/rekhacb.db
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMPLOYEE_DOCUMENT_UPLOAD_DIR=./storage/employee-documents
POLICY_UPLOAD_DIR=./storage/hr-policies
PROFILE_PHOTO_UPLOAD_DIR=./storage/profile-photos

# Optional: without a key, local retrieval and constrained query templates are used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Semantic policy RAG: auto uses semantic embeddings when a key is configured.
# Set semantic to require embeddings, or tfidf for the offline lexical baseline.
POLICY_RETRIEVAL_MODE=auto
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional overrides; blank values reuse AI_API_KEY and AI_BASE_URL.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
POLICY_SIMILARITY_THRESHOLD=0.30
POLICY_VECTOR_DB=./storage/policy_vectors.db
